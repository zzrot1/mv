{
  "name": "reusable-components",
  "version": "0.1.0",
  "description": "Accessible, themeable React 19 components: a data grid and form inputs on a headless core",
  "keywords": [
    "react",
    "react-19",
    "components",
    "data-grid",
    "table",
    "inputs",
    "form",
    "accessible",
    "headless",
    "themeable"
  ],
  "homepage": "https://github.com/zzrot1/mv/tree/main/packages/reusable-components#readme",
  "bugs": "https://github.com/zzrot1/mv/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzrot1/mv.git",
    "directory": "packages/reusable-components"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/stories",
    "!src/**/tests",
    "!src/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "playwright": "^1.64.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-browser-react": "^2.3.0"
  }
}
