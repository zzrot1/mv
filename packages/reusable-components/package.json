{
  "name": "reusable-components",
  "version": "0.1.0",
  "description": "Reusable React components on a headless, framework-free core",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/stories",
    "README.md"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project storybook",
    "test:watch": "vitest --project storybook",
    "test:coverage": "vitest run --project storybook --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "sideEffects": false,
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "playwright": "^1.64.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
